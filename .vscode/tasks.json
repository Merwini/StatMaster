{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build StatMaster (Release)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Source/StatMaster/StatMaster.csproj",
                "-m:1",
                "--configuration",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
            "kind": "build",
            "isDefault": true
            }
        },
        {
            "label": "Build Release 1.6",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Source/StatMaster/StatMaster.sln",
                "-m:1",
                "--configuration",
                "Release",
                "--framework",
                "net48"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Build Release 1.7",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Source/StatMaster/StatMaster.sln",
                "-m:1",
                "--configuration",
                "Release",
                "--framework",
                "net10.0"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
